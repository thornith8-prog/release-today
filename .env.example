# Base URL of the NewsAI backend (no trailing slash)
NEWS_API_URL=https://news-ai-d115c798.fastapicloud.dev

# Endpoint paths. Match them to the API's /docs page
NEWS_API_LATEST_PATH=/recommendations/
NEWS_API_SEARCH_PATH=/search/
NEWS_API_SEARCH_METHOD=GET
NEWS_API_SEARCH_PARAM=q

NEWS_API_TIMEOUT=30

# Topics (requires user access token)
NEWS_API_TOPICS_PATH=/search-topic/topics
NEWS_API_TOPICS_LIMIT=10

# Legal / info pages opened from the sidebar (no trailing slash).
ABOUT_URL=https://newsai.app/about
WHAT_WE_DO_URL=https://newsai.app/what-we-do
TERMS_URL=https://newsai.app/terms
PRIVACY_URL=https://newsai.app/privacy
